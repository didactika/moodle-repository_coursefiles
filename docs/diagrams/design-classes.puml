@startuml
!include _style.puml
title Design — Native repository integration
left to right direction
class repository <<Moodle core>>
class repository_coursebridge {
  + get_listing(path, page)
  + print_search()
  + search(searchtext, page)
  + get_file_reference(source)
  + file_is_accessible(source)
  + copy_to_area(source, record, limits)
}
class catalog <<local_coursebridge>>
class material_source <<local_coursebridge>>
class author_policy <<local_coursebridge>>
repository <|-- repository_coursebridge
repository_coursebridge --> catalog
repository_coursebridge --> material_source
repository_coursebridge --> author_policy
catalog -[hidden]down-> material_source
material_source -[hidden]down-> author_policy
@enduml
