@startuml
!include ../_style.puml
skinparam maxMessageSize 200
title UC02 — Attach a selected material
actor Teacher
participant "Native picker" as Picker
participant repository_multipicker as Repository
participant "material_source / author_policy" as Policy
participant "Core native draft copier" as Draft
Teacher -> Picker : Choose an exact source
Picker -> Repository : get_file_reference(token)
Repository -> Policy : Resolve source / require_native_copy()
alt allowed
  Picker -> Repository : copy_to_area(reference, record)
  Repository -> Policy : Revalidate / capture declaration in transaction
  Repository -> Draft : Copy with source author / licence
  Draft --> Repository : Native draft response / error
  Repository -> Repository : Commit or roll back capture and copy
  Repository --> Picker : Native response / error
else strict / unavailable / unauthorized
  Repository --> Picker : Refuse selection
end
@enduml
